{
  "name": "PULSE Command Center",
  "dataColors": ["#2DD4BF", "#F59E0B", "#818CF8", "#F87171", "#A3E635", "#60A5FA", "#FBBF24", "#C084FC", "#FB7185", "#94A3B8"],
  "background": "#111A27",
  "foreground": "#E5E7EB",
  "tableAccent": "#2DD4BF",
  "good": "#34D399",
  "neutral": "#FBBF24",
  "bad": "#F87171",
  "maximum": "#F87171",
  "center": "#FBBF24",
  "minimum": "#2DD4BF",
  "textClasses": {
    "callout": {"fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#F9FAFB"},
    "title": {"fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#E5E7EB"},
    "header": {"fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#E5E7EB"},
    "label": {"fontSize": 10, "fontFace": "Segoe UI", "color": "#9CA3AF"}
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{"color": {"solid": {"color": "#0B1220"}}, "transparency": 0}],
        "outspace": [{"color": {"solid": {"color": "#0B1220"}}, "transparency": 0}]
      }
    },
    "*": {
      "*": {
        "background": [{"show": true, "color": {"solid": {"color": "#111A27"}}, "transparency": 0}],
        "border": [{"show": true, "color": {"solid": {"color": "#1F2A3A"}}, "radius": 10}],
        "title": [{"fontColor": {"solid": {"color": "#E5E7EB"}}, "fontSize": 11}],
        "visualHeader": [{"foreground": {"solid": {"color": "#9CA3AF"}}, "background": {"solid": {"color": "#111A27"}}}],
        "categoryAxis": [{"labelColor": {"solid": {"color": "#9CA3AF"}}, "titleColor": {"solid": {"color": "#9CA3AF"}}, "gridlineShow": false}],
        "valueAxis": [{"labelColor": {"solid": {"color": "#9CA3AF"}}, "titleColor": {"solid": {"color": "#9CA3AF"}}, "gridlineColor": {"solid": {"color": "#1F2A3A"}}}],
        "legend": [{"labelColor": {"solid": {"color": "#CBD5E1"}}}],
        "labels": [{"color": {"solid": {"color": "#E5E7EB"}}}]
      }
    },
    "slicer": {
      "*": {
        "items": [{"fontColor": {"solid": {"color": "#E5E7EB"}}, "background": {"solid": {"color": "#111A27"}}}],
        "header": [{"fontColor": {"solid": {"color": "#9CA3AF"}}}]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{"gridHorizontalColor": {"solid": {"color": "#1F2A3A"}}, "gridVerticalColor": {"solid": {"color": "#1F2A3A"}}}],
        "columnHeaders": [{"fontColor": {"solid": {"color": "#E5E7EB"}}, "backColor": {"solid": {"color": "#172235"}}}],
        "values": [{"fontColorPrimary": {"solid": {"color": "#E5E7EB"}}, "backColorPrimary": {"solid": {"color": "#111A27"}},
                    "fontColorSecondary": {"solid": {"color": "#E5E7EB"}}, "backColorSecondary": {"solid": {"color": "#0F1724"}}}]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{"fontColor": {"solid": {"color": "#E5E7EB"}}, "backColor": {"solid": {"color": "#172235"}}}],
        "rowHeaders": [{"fontColor": {"solid": {"color": "#E5E7EB"}}, "backColor": {"solid": {"color": "#111A27"}}}],
        "values": [{"fontColorPrimary": {"solid": {"color": "#E5E7EB"}}, "backColorPrimary": {"solid": {"color": "#111A27"}}}]
      }
    }
  }
}
